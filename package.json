{
  "name": "semora",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "prettier --check \"package.json\" \"tsconfig.base.json\" \".prettierrc.json\" \"apps/**/package.json\" \"packages/**/package.json\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}

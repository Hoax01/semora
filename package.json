{
  "name": "semora",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "prettier --check \"package.json\" \"tsconfig.base.json\" \".prettierrc.json\" \"prisma.config.ts\" \"docker-compose.yml\" \"apps/**/package.json\" \"packages/**/package.json\" \"apps/**/*.{ts,tsx,css,html}\" \"prisma/**/*.ts\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prisma": "^7.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

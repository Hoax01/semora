generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AcademicTermType {
  FALL
  SPRING
  SUMMER
  OTHER
}

enum AcademicTermStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum GradingMode {
  ABSOLUTE
  RELATIVE
  PASS_FAIL
  UNKNOWN
}

enum MeetingDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MeetingType {
  LECTURE
  LAB
  TUTORIAL
  SEMINAR
  OTHER
}

enum WorkspaceState {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum CommitmentCategory {
  TASHIP
  SOCIETY
  WORK
  RESEARCH
  GYM
  COMMUTE
  PERSONAL
  OTHER
}

enum CommitmentFlexibility {
  HARD
  SOFT
  FLEXIBLE
}

enum WorkloadProfileSource {
  STRUCTURAL_ESTIMATE
  USER_ESTIMATE
  VERIFIED_OUTLINE
}

enum ActiveCourseSelectionStatus {
  ACTIVE
  DROPPED
}

enum DocumentType {
  COURSE_OUTLINE
  COURSE_MEMO
  COURSE_TIMING
  OTHER
}

enum ExtractionJobStatus {
  PENDING
  PARSING
  EXTRACTING
  REVIEW_REQUIRED
  VERIFIED
  FAILED
}

enum ExtractionVerificationState {
  VERIFIED
  VERIFIED_WITH_GAPS
  REJECTED
}

enum AcademicSourceType {
  VERIFIED_OUTLINE
}

enum GradeAggregationRule {
  EQUAL_MEAN
  POINTS_WEIGHTED_MEAN
  EXPLICIT_WEIGHTS
  BEST_N
  DROP_LOWEST_N
}

enum AssessmentType {
  ASSIGNMENT
  QUIZ
  PROJECT
  PRESENTATION
  MIDTERM
  FINAL
  PARTICIPATION
  OTHER
}

enum AssessmentDatePrecision {
  EXACT
  UNKNOWN
}

enum AssessmentStatus {
  UPCOMING
  SUBMITTED
  GRADED
  MISSING
  EXCUSED
  DROPPED
  CANCELLED
}

model User {
  id                      String                   @id @default(cuid())
  name                    String                   @map("display_name")
  email                   String                   @unique
  emailVerified           Boolean                  @default(false) @map("email_verified")
  image                   String?
  timezone                String                   @default("Asia/Karachi")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  workspaces              SemesterWorkspace[]
  documents               Document[]
  extractionVerifications ExtractionVerification[]
  sessions                Session[]
  accounts                Account[]

  @@map("users")
}

model University {
  id        String         @id @default(cuid())
  name      String
  shortName String         @unique @map("short_name")
  country   String
  timezone  String
  createdAt DateTime       @default(now()) @map("created_at")
  terms     AcademicTerm[]
  courses   Course[]

  @@map("universities")
}

model AcademicTerm {
  id             String              @id @default(cuid())
  universityId   String              @map("university_id")
  name           String
  termType       AcademicTermType    @map("term_type")
  academicYear   String              @map("academic_year")
  startDate      DateTime            @map("start_date") @db.Date
  endDate        DateTime            @map("end_date") @db.Date
  addDropEndDate DateTime?           @map("add_drop_end_date") @db.Date
  examStartDate  DateTime?           @map("exam_start_date") @db.Date
  examEndDate    DateTime?           @map("exam_end_date") @db.Date
  status         AcademicTermStatus  @default(UPCOMING)
  university     University          @relation(fields: [universityId], references: [id], onDelete: Restrict)
  offerings      CourseOffering[]
  workspaces     SemesterWorkspace[]

  @@unique([universityId, name])
  @@map("academic_terms")
}

model Course {
  id                 String           @id @default(cuid())
  universityId       String           @map("university_id")
  courseCode         String           @map("course_code")
  title              String
  description        String?
  creditHoursDefault Decimal          @map("credit_hours_default") @db.Decimal(4, 1)
  department         String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  university         University       @relation(fields: [universityId], references: [id], onDelete: Restrict)
  offerings          CourseOffering[]

  @@unique([universityId, courseCode])
  @@map("courses")
}

model CourseOffering {
  id                  String                  @id @default(cuid())
  courseId            String                  @map("course_id")
  academicTermId      String                  @map("academic_term_id")
  creditHours         Decimal                 @map("credit_hours") @db.Decimal(4, 1)
  descriptionOverride String?                 @map("description_override")
  gradingMode         GradingMode             @default(UNKNOWN) @map("grading_mode")
  sourceConfidence    String                  @default("OFFICIAL_IMPORT") @map("source_confidence")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  course              Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  academicTerm        AcademicTerm            @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  sections            Section[]
  userPreferences     UserCoursePreference[]
  workloadProfiles    CourseWorkloadProfile[]
  documents           Document[]

  @@unique([courseId, academicTermId])
  @@map("course_offerings")
}

model Section {
  id                  String                     @id @default(cuid())
  courseOfferingId    String                     @map("course_offering_id")
  sectionCode         String                     @map("section_code")
  capacity            Int?
  instructorDisplay   String?                    @map("instructor_display")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  courseOffering      CourseOffering             @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  meetings            Meeting[]
  candidateSelections CandidateCourseSelection[]
  activeSelections    ActiveCourseSelection[]
  workloadProfiles    CourseWorkloadProfile[]

  @@unique([courseOfferingId, sectionCode])
  @@map("sections")
}

model Meeting {
  id          String      @id @default(cuid())
  sectionId   String      @map("section_id")
  dayOfWeek   MeetingDay  @map("day_of_week")
  startTime   DateTime    @map("start_time") @db.Time(0)
  endTime     DateTime    @map("end_time") @db.Time(0)
  meetingType MeetingType @default(LECTURE) @map("meeting_type")
  location    String?
  section     Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, dayOfWeek, startTime, endTime, meetingType])
  @@map("meetings")
}

model SemesterWorkspace {
  id                        String                  @id @default(cuid())
  userId                    String                  @map("user_id")
  academicTermId            String                  @map("academic_term_id")
  state                     WorkspaceState          @default(PLANNING)
  lockedCandidateSemesterId String?                 @map("locked_candidate_semester_id")
  lockedAt                  DateTime?               @map("locked_at")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")
  user                      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicTerm              AcademicTerm            @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  lockedCandidateSemester   CandidateSemester?      @relation("WorkspaceLockedCandidate", fields: [lockedCandidateSemesterId], references: [id], onDelete: SetNull)
  preferences               SemesterPreferences?
  candidates                CandidateSemester[]
  activeCourseSelections    ActiveCourseSelection[]
  coursePreferences         UserCoursePreference[]
  workloadProfiles          CourseWorkloadProfile[]
  commitments               Commitment[]
  documents                 Document[]

  @@unique([userId, academicTermId])
  @@map("semester_workspaces")
}

model SemesterPreferences {
  id                             String            @id @default(cuid())
  workspaceId                    String            @unique @map("workspace_id")
  workloadPriority               Decimal           @default(0.5) @map("workload_priority") @db.Decimal(3, 2)
  schedulePriority               Decimal           @default(0.5) @map("schedule_priority") @db.Decimal(3, 2)
  careerPriority                 Decimal           @default(0.5) @map("career_priority") @db.Decimal(3, 2)
  interestPriority               Decimal           @default(0.5) @map("interest_priority") @db.Decimal(3, 2)
  gradeSafetyPriority            Decimal           @default(0.5) @map("grade_safety_priority") @db.Decimal(3, 2)
  projectPreference              Decimal           @default(0.5) @map("project_preference") @db.Decimal(3, 2)
  examPreference                 Decimal           @default(0.5) @map("exam_preference") @db.Decimal(3, 2)
  continuousAssessmentPreference Decimal           @default(0.5) @map("continuous_assessment_preference") @db.Decimal(3, 2)
  freeDayPriority                Decimal           @default(0.5) @map("free_day_priority") @db.Decimal(3, 2)
  earlyClassAversion             Decimal           @default(0.5) @map("early_class_aversion") @db.Decimal(3, 2)
  lateClassAversion              Decimal           @default(0.5) @map("late_class_aversion") @db.Decimal(3, 2)
  maxPreferredHardCourses        Int?              @map("max_preferred_hard_courses")
  createdAt                      DateTime          @default(now()) @map("created_at")
  updatedAt                      DateTime          @updatedAt @map("updated_at")
  workspace                      SemesterWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("semester_preferences")
}

model CandidateSemester {
  id                 String                     @id @default(cuid())
  workspaceId        String                     @map("workspace_id")
  name               String
  isArchived         Boolean                    @default(false) @map("is_archived")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  workspace          SemesterWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  selections         CandidateCourseSelection[]
  lockedByWorkspaces SemesterWorkspace[]        @relation("WorkspaceLockedCandidate")

  @@index([workspaceId, isArchived])
  @@map("candidate_semesters")
}

model ActiveCourseSelection {
  id          String                      @id @default(cuid())
  workspaceId String                      @map("workspace_id")
  sectionId   String                      @map("section_id")
  addedAt     DateTime                    @default(now()) @map("added_at")
  droppedAt   DateTime?                   @map("dropped_at")
  status      ActiveCourseSelectionStatus @default(ACTIVE)
  workspace   SemesterWorkspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  section     Section                     @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  state       ActiveCourseState?

  @@index([workspaceId, status])
  @@index([workspaceId, sectionId, status])
  @@map("active_course_selections")
}

model ActiveCourseState {
  id                      String                @id @default(cuid())
  activeCourseSelectionId String                @unique @map("active_course_selection_id")
  outlineDocumentId       String?               @unique @map("outline_document_id")
  dataCompleteness        Decimal               @default(0) @map("data_completeness") @db.Decimal(3, 2)
  dataConfidence          Decimal               @default(0) @map("data_confidence") @db.Decimal(3, 2)
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  activeCourseSelection   ActiveCourseSelection @relation(fields: [activeCourseSelectionId], references: [id], onDelete: Cascade)
  outlineDocument         Document?             @relation("ActiveCourseOutline", fields: [outlineDocumentId], references: [id], onDelete: SetNull)
  gradingScheme           GradingScheme?
  assessments             Assessment[]
  workloadSignals         WorkloadSignal[]

  @@map("active_course_states")
}

model Document {
  id                    String             @id @default(cuid())
  userId                String             @map("user_id")
  workspaceId           String?            @map("workspace_id")
  courseOfferingId      String?            @map("course_offering_id")
  documentType          DocumentType       @default(COURSE_OUTLINE) @map("document_type")
  originalFilename      String             @map("original_filename")
  storageKey            String             @unique @map("storage_key")
  mimeType              String             @map("mime_type")
  fileSize              Int                @map("file_size")
  fileHash              String             @map("file_hash")
  uploadedAt            DateTime           @default(now()) @map("uploaded_at")
  deletedAt             DateTime?          @map("deleted_at")
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace             SemesterWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  courseOffering        CourseOffering?    @relation(fields: [courseOfferingId], references: [id], onDelete: SetNull)
  activeCourseState     ActiveCourseState? @relation("ActiveCourseOutline")
  extractionJobs        ExtractionJob[]
  gradingSchemeSources  GradingScheme[]    @relation("GradingSchemeSource")
  gradeThresholdSources GradeThreshold[]   @relation("GradeThresholdSource")
  assessmentSources     Assessment[]       @relation("AssessmentSource")
  workloadSignalSources WorkloadSignal[]   @relation("WorkloadSignalSource")

  @@index([userId, uploadedAt])
  @@index([workspaceId, courseOfferingId])
  @@index([userId, fileHash])
  @@map("documents")
}

model ExtractionJob {
  id               String                  @id @default(cuid())
  documentId       String                  @map("document_id")
  status           ExtractionJobStatus     @default(PENDING)
  modelIdentifier  String?                 @map("model_identifier")
  extractorVersion String?                 @map("extractor_version")
  schemaVersion    String?                 @map("schema_version")
  startedAt        DateTime?               @map("started_at")
  completedAt      DateTime?               @map("completed_at")
  failureReason    String?                 @map("failure_reason") @db.Text
  createdAt        DateTime                @default(now()) @map("created_at")
  document         Document                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  draft            ExtractionDraft?
  verification     ExtractionVerification?

  @@index([documentId, createdAt])
  @@index([status, createdAt])
  @@map("extraction_jobs")
}

model ExtractionDraft {
  id                String        @id @default(cuid())
  extractionJobId   String        @unique @map("extraction_job_id")
  draftPayload      Json          @map("draft_payload")
  overallConfidence Decimal       @map("overall_confidence") @db.Decimal(3, 2)
  createdAt         DateTime      @default(now()) @map("created_at")
  extractionJob     ExtractionJob @relation(fields: [extractionJobId], references: [id], onDelete: Cascade)

  @@map("extraction_drafts")
}

model ExtractionVerification {
  id                String                      @id @default(cuid())
  extractionJobId   String                      @unique @map("extraction_job_id")
  verifiedByUserId  String                      @map("verified_by_user_id")
  verifiedAt        DateTime                    @default(now()) @map("verified_at")
  verificationState ExtractionVerificationState @map("verification_state")
  extractionJob     ExtractionJob               @relation(fields: [extractionJobId], references: [id], onDelete: Cascade)
  verifiedByUser    User                        @relation(fields: [verifiedByUserId], references: [id], onDelete: Cascade)

  @@index([verifiedByUserId, verifiedAt])
  @@map("extraction_verifications")
}

model GradingScheme {
  id                  String             @id @default(cuid())
  activeCourseStateId String             @unique @map("active_course_state_id")
  gradingMode         GradingMode        @map("grading_mode")
  totalExpectedWeight Decimal?           @map("total_expected_weight") @db.Decimal(6, 3)
  roundingPolicy      String?            @map("rounding_policy")
  sourceType          AcademicSourceType @map("source_type")
  sourceDocumentId    String             @map("source_document_id")
  verified            Boolean            @default(true)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  activeCourseState   ActiveCourseState  @relation(fields: [activeCourseStateId], references: [id], onDelete: Cascade)
  sourceDocument      Document           @relation("GradingSchemeSource", fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  categories          GradeCategory[]
  thresholds          GradeThreshold[]

  @@map("grading_schemes")
}

model GradeCategory {
  id               String               @id @default(cuid())
  gradingSchemeId  String               @map("grading_scheme_id")
  name             String
  weightPercentage Decimal?             @map("weight_percentage") @db.Decimal(6, 3)
  aggregationRule  GradeAggregationRule @default(EXPLICIT_WEIGHTS) @map("aggregation_rule")
  ruleParameterN   Int?                 @map("rule_parameter_n")
  displayOrder     Int                  @map("display_order")
  gradingScheme    GradingScheme        @relation(fields: [gradingSchemeId], references: [id], onDelete: Cascade)
  assessments      Assessment[]

  @@index([gradingSchemeId, displayOrder])
  @@map("grade_categories")
}

model GradeThreshold {
  id                String             @id @default(cuid())
  gradingSchemeId   String             @map("grading_scheme_id")
  letterGrade       String             @map("letter_grade")
  minimumPercentage Decimal            @map("minimum_percentage") @db.Decimal(6, 3)
  inclusive         Boolean            @default(true)
  sourceType        AcademicSourceType @map("source_type")
  sourceDocumentId  String             @map("source_document_id")
  gradingScheme     GradingScheme      @relation(fields: [gradingSchemeId], references: [id], onDelete: Cascade)
  sourceDocument    Document           @relation("GradeThresholdSource", fields: [sourceDocumentId], references: [id], onDelete: Restrict)

  @@index([gradingSchemeId, minimumPercentage])
  @@map("grade_thresholds")
}

model Assessment {
  id                   String                  @id @default(cuid())
  activeCourseStateId  String                  @map("active_course_state_id")
  gradeCategoryId      String?                 @map("grade_category_id")
  title                String
  assessmentType       AssessmentType          @map("assessment_type")
  weightPercentage     Decimal?                @map("weight_percentage") @db.Decimal(6, 3)
  pointsPossible       Decimal?                @map("points_possible") @db.Decimal(8, 3)
  dueAt                DateTime?               @map("due_at") @db.Date
  datePrecision        AssessmentDatePrecision @map("date_precision")
  status               AssessmentStatus        @default(UPCOMING)
  estimatedEffortHours Decimal?                @map("estimated_effort_hours") @db.Decimal(5, 2)
  effortConfidence     Decimal?                @map("effort_confidence") @db.Decimal(3, 2)
  isGroupAssessment    Boolean                 @default(false) @map("is_group_assessment")
  sourceType           AcademicSourceType      @map("source_type")
  sourceDocumentId     String?                 @map("source_document_id")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  activeCourseState    ActiveCourseState       @relation(fields: [activeCourseStateId], references: [id], onDelete: Cascade)
  gradeCategory        GradeCategory?          @relation(fields: [gradeCategoryId], references: [id], onDelete: SetNull)
  sourceDocument       Document?               @relation("AssessmentSource", fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([activeCourseStateId, dueAt])
  @@index([gradeCategoryId])
  @@map("assessments")
}

model WorkloadSignal {
  id                  String             @id @default(cuid())
  activeCourseStateId String             @map("active_course_state_id")
  signalType          String             @map("signal_type")
  value               Decimal?           @db.Decimal(8, 3)
  sourceDocumentId    String             @map("source_document_id")
  confidence          Decimal?           @db.Decimal(3, 2)
  sourceType          AcademicSourceType @map("source_type")
  activeCourseState   ActiveCourseState  @relation(fields: [activeCourseStateId], references: [id], onDelete: Cascade)
  sourceDocument      Document           @relation("WorkloadSignalSource", fields: [sourceDocumentId], references: [id], onDelete: Restrict)

  @@unique([activeCourseStateId, signalType])
  @@map("workload_signals")
}

model CandidateCourseSelection {
  id                  String            @id @default(cuid())
  candidateSemesterId String            @map("candidate_semester_id")
  sectionId           String            @map("section_id")
  createdAt           DateTime          @default(now()) @map("created_at")
  candidateSemester   CandidateSemester @relation(fields: [candidateSemesterId], references: [id], onDelete: Cascade)
  section             Section           @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([candidateSemesterId, sectionId])
  @@index([sectionId])
  @@map("candidate_course_selections")
}

model CourseWorkloadProfile {
  id                      String                @id @default(cuid())
  workspaceId             String                @map("workspace_id")
  courseOfferingId        String                @map("course_offering_id")
  sectionId               String?               @map("section_id")
  overallIntensity        Decimal?              @map("overall_intensity") @db.Decimal(3, 1)
  continuousWorkload      Decimal?              @map("continuous_workload") @db.Decimal(3, 1)
  assignmentIntensity     Decimal?              @map("assignment_intensity") @db.Decimal(3, 1)
  quizIntensity           Decimal?              @map("quiz_intensity") @db.Decimal(3, 1)
  projectIntensity        Decimal?              @map("project_intensity") @db.Decimal(3, 1)
  examIntensity           Decimal?              @map("exam_intensity") @db.Decimal(3, 1)
  labIntensity            Decimal?              @map("lab_intensity") @db.Decimal(3, 1)
  readingIntensity        Decimal?              @map("reading_intensity") @db.Decimal(3, 1)
  scheduleBurden          Decimal?              @map("schedule_burden") @db.Decimal(3, 1)
  assessmentFragmentation Decimal?              @map("assessment_fragmentation") @db.Decimal(3, 1)
  estimatedWeeklyHours    Decimal?              @map("estimated_weekly_hours") @db.Decimal(5, 2)
  confidence              Decimal               @default(0.35) @db.Decimal(3, 2)
  sourceType              WorkloadProfileSource @map("source_type")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  workspace               SemesterWorkspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  courseOffering          CourseOffering        @relation(fields: [courseOfferingId], references: [id], onDelete: Restrict)
  section                 Section?              @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, courseOfferingId])
  @@index([courseOfferingId])
  @@map("course_workload_profiles")
}

model UserCoursePreference {
  id                       String            @id @default(cuid())
  workspaceId              String            @map("workspace_id")
  courseOfferingId         String            @map("course_offering_id")
  interestScore            Decimal?          @map("interest_score") @db.Decimal(3, 2)
  careerRelevanceScore     Decimal?          @map("career_relevance_score") @db.Decimal(3, 2)
  manualDifficultyEstimate Decimal?          @map("manual_difficulty_estimate") @db.Decimal(3, 2)
  manualNotes              String?           @map("manual_notes")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  workspace                SemesterWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  courseOffering           CourseOffering    @relation(fields: [courseOfferingId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, courseOfferingId])
  @@index([courseOfferingId])
  @@map("user_course_preferences")
}

model Commitment {
  id                String                @id @default(cuid())
  workspaceId       String                @map("workspace_id")
  name              String
  category          CommitmentCategory
  weeklyEffortHours Decimal               @default(0) @map("weekly_effort_hours") @db.Decimal(5, 2)
  flexibility       CommitmentFlexibility @default(FLEXIBLE)
  priority          Decimal               @default(0.5) @db.Decimal(3, 2)
  startDate         DateTime?             @map("start_date") @db.Date
  endDate           DateTime?             @map("end_date") @db.Date
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  workspace         SemesterWorkspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meetings          CommitmentMeeting[]

  @@index([workspaceId])
  @@map("commitments")
}

model CommitmentMeeting {
  id           String     @id @default(cuid())
  commitmentId String     @map("commitment_id")
  dayOfWeek    MeetingDay @map("day_of_week")
  startTime    DateTime   @map("start_time") @db.Time(0)
  endTime      DateTime   @map("end_time") @db.Time(0)
  commitment   Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  @@unique([commitmentId, dayOfWeek, startTime, endTime])
  @@map("commitment_meetings")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  issuer                String?
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token") @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("auth_verifications")
}
